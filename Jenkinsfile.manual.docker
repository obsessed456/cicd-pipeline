 pipeline {
     agent any

     stages {
         stage('Deploy') {
             steps {
                 sh 'docker pull obsessed456/nodemain:v1.0'
                 sh 'docker rm -f nodemain || true'
                 sh 'docker run -d --name nodemain -p 3000:3000 obsessed456/nodemain:v1.0'
             }
         }
     }
 }
          
